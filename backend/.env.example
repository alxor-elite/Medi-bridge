# ---------------------------------------------------------------
# MediBridge backend environment
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------

PORT=5000
NODE_ENV=development

# --- Supabase -------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Public anon key (safe for the frontend)
SUPABASE_ANON_KEY=
# Service role key - SERVER ONLY. Never send this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth -----------------------------------------------------
# Long random string. Generate with:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- AI assistant (POST /api/ai/chat) -------------------------
# PRIMARY: the MediBridge FastAPI service in front of the self-hosted
# LLM, without a trailing /chat. This is the normal answer path and it
# is not replaced by anything below. The ngrok hostname changes each
# time the tunnel restarts.
AI_SERVICE_URL=https://your-tunnel.ngrok-free.dev

# How long the primary is given to answer before it counts as a timeout.
# Deliberately generous: a slow answer is still the primary's answer, and
# the fallback must not steal a request that was merely taking its time.
AI_PRIMARY_TIMEOUT_MS=30000

# FALLBACK: Google Gemini, used ONLY when the primary is unreachable,
# returns 5xx, times out, raises an inference error, or returns an empty
# or unparseable response.
#
# SERVER ONLY. This key must never be copied into a VITE_ variable, sent
# to the browser, or committed. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_FALLBACK_TIMEOUT_MS=20000

# --- CORS -----------------------------------------------------
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# --- Database driver ------------------------------------------
# "supabase" (default, real database) or "memory" (in-process store
# for local development and automated tests ONLY - data is lost on
# restart and it refuses to start when NODE_ENV=production).
DB_DRIVER=supabase

# Load the demo data at boot when the database is empty. Mainly for
# DB_DRIVER=memory, where `npm run seed` would write to a store that dies with
# the seed process. Leave this false for a real Supabase deployment.
SEED_ON_START=false

# --- Tunables (see src/config/constants.js for defaults) -------
# Inventory freshness thresholds, in minutes
FRESHNESS_FRESH_MINUTES=30
FRESHNESS_RECENT_MINUTES=360

# How long a stock reservation is held before it auto-expires
RESERVATION_TTL_MINUTES=10

# Supplier ranking weights (must add up to 1)
RANK_WEIGHT_ETA=0.40
RANK_WEIGHT_DISTANCE=0.25
RANK_WEIGHT_STOCK=0.20
RANK_WEIGHT_RELIABILITY=0.10
RANK_WEIGHT_PRICE=0.05

# Average delivery speed used for the straight-line ETA estimate
AVERAGE_SPEED_KMH=28
DISPATCH_OVERHEAD_MINUTES=8
