# ---------------------------------------------------------------
# MediBridge frontend environment
# Copy to `.env` (or set these in your hosting provider) — anything
# prefixed with VITE_ is embedded in the public bundle, so NEVER put
# secrets, service-role keys or JWT secrets in this file.
# ---------------------------------------------------------------

# Base URL of the MediBridge API. Required for production builds.
# Either form works — the client normalises both to exactly one /api suffix:
#   https://medi-bridge-kpb1.onrender.com
#   https://medi-bridge-kpb1.onrender.com/api
# Note the service name ends in the digit 1, not a lowercase L.
# Requests are then sent to <base>/api/auth/login, /api/auth/register, etc.
# Leave it unset in development: the app then calls the same-origin /api path,
# which the Vite dev server proxies to DEV_API_PROXY below.
VITE_API_URL=

# Dev server only (not embedded in the bundle): where /api is proxied.
DEV_API_PROXY=http://localhost:5000
